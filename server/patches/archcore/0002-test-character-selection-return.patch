+use super::{TestClient, char_mgr_op, decode_mini, login_op, mini, schema, world_op};
+use crate::config::Config;
+use crate::db::{Databases, col};
+use crate::world::return_login::op;
+use anyhow::{Context, Result, ensure};
+use archcore_net::rc4::capi_crypt;
+use archcore_net::{Fields, build_mini, text};
+use std::path::Path;
+use std::time::Duration;
+use tokio::io::AsyncReadExt;
+use tokio::net::TcpStream;
+
+const OWNER: &str = "FixtureRéturn";
+const OTHER: &str = "FixtureOther";
+const CHARACTER: &str = "FixtureKnight";
+const LOGIN_PORT: u16 = 12102;
+const WORLD_PORT: u16 = 12108;
+const DATABASE_PORT: u16 = 3347;
+
+#[tokio::test]
+#[ignore = "requires the disposable MariaDB fixture"]
+async fn archonia_665_return_to_selection() -> Result<()> {
+    crate::log::init();
+    let cfg = crate::config::load()?;
+    let expected_datadir = cfg.root.join("database").canonicalize()?;
+    ensure!(cfg.root.file_name().is_some_and(|name| name.to_string_lossy().starts_with("return-fixture-")));
+    ensure!(cfg.database.host == "127.0.0.1" && cfg.database.port == DATABASE_PORT);
+    ensure!(cfg.login.bind == "127.0.0.1" && cfg.login.port == LOGIN_PORT);
+    ensure!(cfg.world.bind == "127.0.0.1" && cfg.world.port == WORLD_PORT && !cfg.world.soap.enabled);
+    let db = Databases::new(&cfg.database);
+    let endpoint = db.auth.first("SELECT @@datadir AS path, @@port AS port", ()).await?.context("database endpoint")?;
+    let path: String = col(&endpoint, "path");
+    ensure!(Path::new(&path).canonicalize()? == expected_datadir && col::<u16>(&endpoint, "port") == DATABASE_PORT);
+    let owner_password = format!("{:032x}", rand::random::<u128>());
+    let other_password = format!("{:032x}", rand::random::<u128>());
+    let cid = seed(&db, &owner_password, &other_password).await?;
+
+    let mut server = tokio::spawn(crate::server::run("all"));
+    let result = tokio::select! {
+        result = exercise(&cfg, &db, cid, &owner_password, &other_password) => result,
+        stopped = &mut server => {
+            stopped.context("fixture server task")??;
+            anyhow::bail!("fixture server exited before the regression completed");
+        }
+    };
+    server.abort();
+    let _ = server.await;
+    db.close().await;
+    result
+}
+
+async fn seed(db: &Databases, owner_password: &str, other_password: &str) -> Result<u32> {
+    let row = db.auth.first("SELECT COUNT(*) AS accounts FROM account", ()).await?.context("account count")?;
+    ensure!(col::<u64>(&row, "accounts") == 0, "the integration database must be fresh");
+    let owner = db.auth.exec("INSERT INTO account (username, password_hash) VALUES (?, ?)", (OWNER, crate::login::sha256_hex(owner_password.as_bytes()))).await?;
+    db.auth.exec("INSERT INTO account (username, password_hash) VALUES (?, ?)", (OTHER, crate::login::sha256_hex(other_password.as_bytes()))).await?;
+    db.world.exec("INSERT INTO character_data_table (tid, name, data) VALUES (96, 'Knight', ?)", (r#"{"Race":"1","Class":"1"}"#,)).await?;
+    let cid = db.characters.exec(
+        "INSERT INTO characters (account_id, name, template_id, hp, mp, sp, pos_x, pos_y, pos_z) VALUES (?, ?, 96, 100, 50, 100, 100, 20, 40)",
+        (owner, CHARACTER),
+    ).await?;
+    Ok(cid.try_into()?)
+}
+
+async fn exercise(cfg: &Config, db: &Databases, cid: u32, owner_password: &str, other_password: &str) -> Result<()> {
+    let login_address = format!("127.0.0.1:{LOGIN_PORT}");
+    let world_address = format!("127.0.0.1:{WORLD_PORT}");
+    tokio::time::timeout(Duration::from_secs(20), async {
+        while TcpStream::connect(&world_address).await.is_err() {
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+    }).await.context("fixture listeners did not start")?;
+
+    let mut invalid = encrypted_login(&login_address).await?;
+    let hash = request_challenge(&mut invalid).await?;
+    credentials(&mut invalid, &hash, OWNER, "wrong-password").await?;
+    expect_rejection(&mut invalid).await?;
+
+    let mut login = encrypted_login(&login_address).await?;
+    login.send(&schema::WORLD, Fields::new(&schema::WORLD).with(0, world_op::SERVER_LIST_REQ)).await?;
+    let worlds = login.expect(&schema::WORLD, Some(world_op::SERVER_LIST_ANS)).await?.fields().text(3).context("world list")?;
+    let world_name = worlds.split('=').next().context("world name")?;
+    ensure!(world_name == cfg.world.name);
+    let hash = request_challenge(&mut login).await?;
+    let request_account = credentials(&mut login, &hash, OWNER, owner_password).await?;
+    let reply = login.expect(&schema::LOGIN, None).await?;
+    ensure!(reply.int(0) == Some(login_op::USER_LOGIN), "normal login rejected");
+    let cached_account = reply.fields().bytes(2).context("login acknowledgement account")?.to_vec();
+    let mut world = enter_world(login, world_name, &world_address, cid).await?;
+    let key = request_return(&mut world, &login_address, cid).await?;
+    drop(world);
+
+    let mut legacy = encrypted_login(&login_address).await?;
+    send_return(&mut legacy, Some(request_account), key).await?;
+    expect_rejection(&mut legacy).await.context("the old acknowledgement echoed RC4 bytes")?;
+
+    ensure!(reply.fields().text(2).as_deref() == Some(OWNER), "login acknowledgement must carry the canonical account text");
+    let utf16 = OWNER.encode_utf16().flat_map(u16::to_le_bytes).collect();
+    for (label, field, value) in [
+        ("missing", None, key),
+        ("empty", Some(Vec::new()), key),
+        ("spaces", Some(vec![b' '; 3]), key),
+        ("UTF-16", Some(utf16), key),
+        ("different account", Some(text::encode(OTHER)), key),
+        ("wrong key", Some(cached_account.clone()), if key == 1 { 2 } else { 1 }),
+        ("missing key", Some(cached_account.clone()), 0),
+        ("negative key", Some(cached_account.clone()), -1),
+    ] {
+        let mut returned = encrypted_login(&login_address).await?;
+        send_return(&mut returned, field, value).await?;
+        expect_rejection(&mut returned).await.with_context(|| format!("reject {label}"))?;
+    }
+
+    let mut a = encrypted_login(&login_address).await?;
+    let mut b = encrypted_login(&login_address).await?;
+    send_return(&mut a, Some(cached_account.clone()), key).await?;
+    send_return(&mut b, Some(cached_account.clone()), key).await?;
+    let (a_reply, b_reply) = tokio::try_join!(a.expect(&schema::LOGIN, None), b.expect(&schema::LOGIN, None))?;
+    let (mut returned, challenge, rejected) = if a_reply.int(0) == Some(login_op::HASHKEY) {
+        (a, a_reply, b_reply)
+    } else {
+        (b, b_reply, a_reply)
+    };
+    ensure!(challenge.int(0) == Some(login_op::HASHKEY), "return with the cached account and valid key was rejected");
+    ensure!(rejected.int(0) == Some(login_op::LOGIN_RESULT) && rejected.int(10) == Some(schema::login_result::INCORRECT_USER), "a return key was accepted twice");
+    let hash = challenge.fields().text(1).context("return challenge")?;
+    credentials(&mut returned, &hash, OTHER, other_password).await?;
+    expect_rejection(&mut returned).await.context("return is bound to the key owner")?;
+    credentials(&mut returned, &hash, OWNER, "wrong-password").await?;
+    expect_rejection(&mut returned).await.context("return still checks the password")?;
+    credentials(&mut returned, &hash, OWNER, owner_password).await?;
+    let auth = returned.expect(&schema::LOGIN, None).await?;
+    ensure!(auth.int(0) == Some(login_op::USER_LOGIN) && auth.fields().text(2).as_deref() == Some(OWNER));
+    returned.expect(&schema::RETURN_TO_LOGIN, Some(op::END_PROCESS)).await?;
+
+    let mut world = enter_world(returned, world_name, &world_address, cid).await?;
+    let key = request_return(&mut world, &login_address, cid).await?;
+    db.auth.exec("UPDATE account SET return_key_until = NOW() - INTERVAL 1 SECOND WHERE username = ?", (OWNER,)).await?;
+    let mut expired = encrypted_login(&login_address).await?;
+    send_return(&mut expired, Some(cached_account), key).await?;
+    expect_rejection(&mut expired).await.context("expired return key")?;
+    println!("Verified normal login, ordered handoff, fresh Blowfish, return field variants, single use, account binding, reauthentication, character selection and expiry");
+    Ok(())
+}
+
+async fn encrypted_login(endpoint: &str) -> Result<TestClient> {
+    let mut client = TestClient::connect("fixture-login", endpoint).await?;
+    client.handshake().await?;
+    Ok(client)
+}
+
+async fn request_challenge(client: &mut TestClient) -> Result<String> {
+    let lg = &schema::LOGIN;
+    client.send(lg, Fields::new(lg).with(0, login_op::HASHKEY)).await?;
+    client.expect(lg, Some(login_op::HASHKEY)).await?.fields().text(1).context("login challenge")
+}
+
+async fn credentials(client: &mut TestClient, hash: &str, user: &str, password: &str) -> Result<Vec<u8>> {
+    let lg = &schema::LOGIN;
+    let account = capi_crypt(hash.as_bytes(), &text::encode(user));
+    let password = capi_crypt(hash.as_bytes(), &text::encode(password));
+    let password_len = password.len();
+    client.send(lg, Fields::new(lg).with(0, login_op::USER_LOGIN).with(2, account.clone()).with(3, account.len()).with(4, password).with(5, password_len)).await?;
+    Ok(account)
+}
+
+async fn send_return(client: &mut TestClient, account: Option<Vec<u8>>, key: i64) -> Result<()> {
+    let schema = &schema::RETURN_TO_LOGIN;
+    let mut fields = Fields::new(schema).with(0, op::RECONNECT_LOGIN_SERVER);
+    if let Some(bytes) = account {
+        fields = fields.with(2, bytes);
+    }
+    if key != 0 {
+        fields = fields.with(5, key);
+    }
+    client.send(schema, fields).await
+}
+
+async fn expect_rejection(client: &mut TestClient) -> Result<()> {
+    let response = client.expect(&schema::LOGIN, None).await?;
+    ensure!(response.int(0) == Some(login_op::LOGIN_RESULT) && response.int(10) == Some(schema::login_result::INCORRECT_USER));
+    Ok(())
+}
+
+async fn enter_world(mut login: TestClient, world_name: &str, endpoint: &str, cid: u32) -> Result<TestClient> {
+    let lg = &schema::LOGIN;
+    let cm = &schema::CHAR_MANAGER;
+    login.send(lg, Fields::new(lg).with(0, login_op::UNION_INFO).with(7, world_name)).await?;
+    login.expect(lg, Some(login_op::UNION_INFO)).await?;
+    let character = login.expect(lg, Some(login_op::CHAR_NAME)).await?;
+    let info = decode_mini(&mini::LOGIN_CHAR_INFO, character.fields().bytes(8).context("character info")?)?;
+    ensure!(info.text(1).as_deref() == Some(CHARACTER));
+    login.expect(lg, Some(login_op::CHAR_NAME_FINISH)).await?;
+    let m = &mini::LOGIN_CHAR_INFO;
+    let request = build_mini(m, &Fields::new(m).with(1, CHARACTER));
+    login.send(lg, Fields::new(lg).with(0, login_op::WORLD_ENTER).with(8, request)).await?;
+    let auth = login.expect_where(|_| true, 5_000, "AUTH_KEY before WORLD_ENTER").await?;
+    ensure!(auth.is(cm, Some(char_mgr_op::AUTH_KEY)));
+    let key = auth.int(6).filter(|&key| key > 0).context("world key")?;
+    let transfer = login.expect_where(|_| true, 5_000, "WORLD_ENTER before EOF").await?;
+    ensure!(transfer.is(lg, Some(login_op::WORLD_ENTER)) && transfer.int(6) == Some(i64::from(cid)));
+    let advertised = decode_mini(&mini::LOGIN_SERVER_INFO, transfer.fields().bytes(9).context("world endpoint")?)?;
+    ensure!(advertised.text(0).as_deref() == Some(endpoint));
+    require_eof(&mut login).await.context("old login socket must close after the transfer")?;
+
+    let mut world = TestClient::connect("fixture-world", endpoint).await?;
+    world.handshake().await?;
+    let full_name = format!("{CHARACTER}#{world_name}");
+    world.send(cm, Fields::new(cm).with(0, char_mgr_op::GAME_ENTER).with(2, 17).with(3, full_name.as_str()).with(6, key).with(7, "")).await?;
+    world.expect(&schema::CONFIG, None).await?;
+    world.expect(&schema::CHARACTER, Some(25)).await?;
+    let loading = world.expect(cm, Some(char_mgr_op::LOADING_POS)).await?;
+    ensure!(loading.int(4) == Some(i64::from(cid)));
+    let pos = loading.fields().vec3(5).context("loading position")?;
+    ensure!((pos.x, pos.y, pos.z) == (100.0, 20.0, 40.0));
+    world.send(cm, Fields::new(cm).with(0, char_mgr_op::ENTER_WORLD)).await?;
+    world.expect(cm, Some(char_mgr_op::FINISH_ENTER)).await?;
+    Ok(world)
+}
+
+async fn require_eof(client: &mut TestClient) -> Result<()> {
+    ensure!(client.queue.is_empty());
+    let mut buffer = [0u8; 1];
+    let count = tokio::time::timeout(Duration::from_secs(5), client.stream.read(&mut buffer)).await??;
+    ensure!(count == 0, "expected a clean TCP EOF");
+    Ok(())
+}
+
+async fn request_return(world: &mut TestClient, login_address: &str, cid: u32) -> Result<i64> {
+    let schema = &schema::RETURN_TO_LOGIN;
+    world.send(schema, Fields::new(schema).with(0, op::REQUEST).with(1, cid)).await?;
+    let grant = world.expect(schema, Some(op::SEND_KEY_ADDR)).await?;
+    ensure!(grant.int(1) == Some(i64::from(cid)) && grant.fields().text(4).as_deref() == Some(login_address));
+    grant.int(5).filter(|&key| key > 0).context("return grant")
+}
